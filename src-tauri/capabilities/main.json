{
  "identifier": "main-window",
  "description": "Local app event listener for managed close and progress",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "core:window:allow-scale-factor",
    "core:window:allow-inner-position",
    "core:window:allow-cursor-position"
  ]
}
