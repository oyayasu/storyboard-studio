{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Storyboard Studio Next",
  "version": "0.12.0",
  "identifier": "local.filipe.storyboardstudio.next",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Storyboard Studio \u2014 0.12.0",
        "width": 1500,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 670,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**",
            "**/Studio Link/.incoming/**",
            "**/Studio Link/.recovery/media/**"
          ],
          "requireLiteralLeadingDot": true
        }
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
